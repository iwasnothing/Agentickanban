# Example environment for the Agentic Kanban control plane.
# Copy to a 600-mode file *outside* git if you like (for example
# $KANBAN_SECRETS_DIR/kanban-webui.env) or export these in the shell
# that starts the services. Never commit a filled-in copy.
#
# Start scripts also read secrets from files (preferred: no values on
# a command line or in git). See SETUP.md.

# --- Paths (defaults on the reference box are /workspace/... ) ---
# Parent directory that holds this repo plus the official DSH and OpenMausBot checkouts.
KANBAN_ROOT=
# This control-plane checkout (tickets, MCP servers, web UI, start scripts).
AIBOTS_CONTROL_ROOT=
# Official dsh-superagent-prototype checkout (for .artifacts logs and official start scripts).
DSH_SUPERAGENT_ROOT=
# Official OpenMausBot checkout (only needed if you start the server with pnpm dev:server).
OPENMAUSBOT_ROOT=
# Directory for mode-600 secret files (keys, tokens, invite code). Not a git repo.
KANBAN_SECRETS_DIR=
# Demo / worker project git repo and per-bot worktrees.
AIBOTS_PROJECT_REPO=
AIBOTS_WORKSPACES_ROOT=
# Optional override of .state/
# AIBOTS_STATE_DIR=

# --- OpenRouter (DSH Superagent manager model) ---
# Preferred: path to a mode-600 file that contains only the API key (no newline required).
OPENROUTER_KANBAN_KEY_FILE=
# The start_dsh_superagent.sh script loads the file into these env vars (do not put the key here).
OPENROUTER_KANBAN_API_KEY=
OPENROUTER_API_KEY=
# Optional model override used by the local web UI when talking to DSH.
# KANBAN_DSH_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- GitHub Issues + Projects v2 sync (optional; dry-run if unset) ---
# Preferred: mode-600 file containing a PAT or installation token
# (Issues RW, Projects RW, Contents RW).
GITHUB_TOKEN_FILE=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_PROJECT=

# --- Local web UI (127.0.0.1:8787) ---
# Invite code for the login page. Prefer setting this rather than relying on
# a generated file. Never commit the value.
KANBAN_INVITE_CODE=
# Optional path to a file that holds only the invite code, if you do not want it in env.
# KANBAN_INVITE_CODE_FILE=
# Session cookie signing key file (mode 600). Created on first start if missing.
# KANBAN_WEBUI_SESSION_KEY_FILE=
# Optional 600-mode env file sourced by start_kanban_webui.sh (values already
# in the environment win). Typical keys: KANBAN_INVITE_CODE, SIMULAR_BOX_TOKEN.
# KANBAN_WEBUI_ENV_FILE=
# KANBAN_WEBUI_PORT=8787
# Optional: Simular VM health indicator. Leave empty if unused.
SIMULAR_BOX_TOKEN=
# Optional rate limit for "+ New task".
# KANBAN_MAX_TASKS_PER_HOUR=4

# --- Binaries and DSH ---
# DSH_BIN=
# DSH_PROFILE=superagent
# DSH_PERMISSION_MODE=danger-full-access
# DSH_ARTIFACTS_DIR=
# OpenMausBot listen port (MCP client and CLI). Default 8799.
# OMB_PORT=8799

# --- Watchdog ---
# WATCHDOG_INTERVAL=60

# --- Optional leftover Vercel bridge (not required for the local UI) ---
# KANBAN_VERCEL_URL=
# BRIDGE_SECRET=
# KANBAN_VERCEL_ENV_FILE=
